# Pear API environment. Every value below is the DEFAULT, so `cp .env.example .env` changes
# nothing; edit only what you need. `make dev` loads api/.env if it exists (shell syntax,
# no spaces around =). Cloud Run gets its env from infra/deploy.sh, not from this file.
# Source of truth: api/core/config.py (GET /debug/config prints the resolved values) plus the
# few module-level knobs noted below. Never commit a real .env (it is gitignored).

# --- identity ---
PEAR_VERSION=0.3.0                        # shown in /health as version+git_sha
PEAR_GIT_SHA=dev                          # deploy.sh sets the short git sha

# --- Google Cloud ---
PEAR_PROJECT=pear-510410                  # falls back to GOOGLE_CLOUD_PROJECT, then pear-510410
PEAR_REGION=us-central1                   # Cloud Run + Firestore (nam5) region, informational
PEAR_GEMINI_LOCATION=global               # Gemini 3.x is only served from "global" (addendum 5.8)

# --- models ---
PEAR_MODEL_LABEL=gemini-3.5-flash-lite    # label_reader (photo path, one call)
PEAR_MODEL_QUESTION=gemini-3.5-flash-lite # question_reader (ask path, one call)
PEAR_MODEL_TEXT=gemini-3.5-flash-lite     # explain, profile parse, unknown terms, /health?deep=1
PEAR_MODEL_PRICE=gemini-3.5-flash         # price_finder (Grounding with Google Search)
PEAR_MODEL_EMBEDDING=gemini-embedding-2   # product + query vectors
PEAR_MODEL_EMBEDDING_FALLBACK=gemini-embedding-001  # used if the primary embedding model fails
PEAR_EMBEDDING_DIM=768                    # must match the Firestore vector index (768)

# --- timeouts, seconds (addendum 5.2) ---
PEAR_T_OFF=1.1                            # Open Food Facts / Beauty Facts race cap
PEAR_T_OFF_MAX=2.5                        # hard cap, only while OFF is still loading (cold TLS != not found)
PEAR_T_FDC=1.5                            # USDA FoodData Central fallback
PEAR_T_LABEL=4.0                          # label_reader Gemini call
PEAR_T_QUESTION=2.5                       # question_reader Gemini call
PEAR_T_AUDIO=4.0                          # ask audio fallback (m4a) Gemini call
PEAR_T_TEXT=3.0                           # explain / profile / other text calls
PEAR_T_EMBED=2.0                          # embedding call
PEAR_T_PRICE=6.0                          # price_finder per product
PEAR_T_PICKS_WAIT=2.5                     # /v1/picks waits this long for the prefetch
PEAR_T_FIRESTORE=1.0                      # per Firestore read/write

# --- behaviour switches ---
PEAR_STORE=auto                           # auto (firestore if ADC works, else memory) | firestore | memory
PEAR_AUTH=optional                        # off | optional (verify token if sent) | required
PEAR_ASK_ENGINE=adk                       # adk (ADK Workflow, falls back to direct) | direct
# PEAR_TRACE=0                            # Cloud Trace export; default ON on Cloud Run, OFF locally
PEAR_DEBUG_ROUTES=1                       # serve /debug/* (config, off raw json, evaluate)
# PEAR_LOG_FORMAT=pretty                  # pretty | json; default json on Cloud Run, pretty locally
PEAR_LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING

# --- features (flip to 0 to cut, addendum 16 cut order) ---
PEAR_FEATURE_PICKS=1                      # picks prefetch + /v1/picks
PEAR_FEATURE_VECTOR=1                     # Firestore vector candidates (else category_main fallback)
PEAR_FEATURE_PRICES=1                     # price_finder + /v1/prices
PEAR_FEATURE_EXPLAIN=1                    # /v1/explain
PEAR_FEATURE_ENRICH=1                     # background Gemini mapping of unknown ingredient strings
PEAR_FEATURE_SCAN_LOG=1                   # scans/{id} log writes
PEAR_FEATURE_FDC=1                        # USDA FDC fallback when OFF misses (needs USDA_API_KEY)

# --- external APIs ---
USDA_API_KEY=                             # empty = FDC off. Cloud Run: Secret Manager usda-api-key (infra/secrets.sh)
PEAR_CONTACT_EMAIL=pear-hackathon-app     # Open Food Facts User-Agent contact: "Pear/0.3.0 (<this>)"
PEAR_OFF_BASE=https://world.openfoodfacts.org
PEAR_OBF_BASE=https://world.openbeautyfacts.org
PEAR_FDC_BASE=https://api.nal.usda.gov/fdc/v1
# PEAR_FIXTURES_DIR=../contracts/fixtures # /mock fixtures; default auto-detects <repo>/contracts/fixtures

# --- module-level knobs (read at import time, outside core/config.py) ---
PEAR_OFF_SEARCH_BASE=https://search.openfoodfacts.org  # pipeline/lookup_off.py name/category search
PEAR_OFF_READS_PER_MIN=80                 # pipeline/lookup_off.py OFF product reads per minute per host (OFF allows ~100)
PEAR_OFF_SEARCHES_PER_MIN=10              # pipeline/lookup_off.py OFF searches per minute per host
PEAR_NAME_MATCH_MAX_DIST=0.35             # pipeline/products.py max cosine distance for a name match
PEAR_MISSING_RECHECK_S=600                # pipeline/products.py re-fetch a cached product with no ingredient list after this long
